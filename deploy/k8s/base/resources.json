        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "recordchat",
                    "app.kubernetes.io/component": "gateway"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 3000
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "gateway-to-frontend"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "recordchat",
            "app.kubernetes.io/component": "gateway"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "recordchat",
                    "app.kubernetes.io/component": "frontend"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 3000
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "backend-ingress"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "recordchat",
            "app.kubernetes.io/component": "backend"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "recordchat",
                    "app.kubernetes.io/component": "frontend"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8000
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "frontend-to-backend"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "recordchat",
            "app.kubernetes.io/component": "frontend"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "recordchat",
                    "app.kubernetes.io/component": "backend"
                  }
                }
              }
            ],
            "ports": [
