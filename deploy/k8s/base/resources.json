    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "qdrant-ingress"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "recordchat",
            "app.kubernetes.io/component": "qdrant"
          }
        },
        "policyTypes": [
