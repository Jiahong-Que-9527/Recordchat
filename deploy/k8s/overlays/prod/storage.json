{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {
        "name": "rc-prod-app-state"
      },
      "spec": {
        "capacity": {
          "storage": "2Gi"
        },
        "volumeMode": "Filesystem",
        "accessModes": [
          "ReadWriteOnce"
        ],
        "persistentVolumeReclaimPolicy": "Retain",
        "storageClassName": "",
        "claimRef": {
          "namespace": "recordchat-prod",
          "name": "app-state"
        },
        "hostPath": {
          "path": "/var/lib/recordchat/recordchat-prod/app-state",
          "type": "Directory"
        },
        "nodeAffinity": {
          "required": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/hostname",
                    "operator": "In",
                    "values": [
                      "sololakehouse"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
