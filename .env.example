# ----- LLM -----
# provider: openai | qwen | claude
# User-facing chat allowlist (see GET /models): deepseek-v4-flash | deepseek-v4-pro
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=

# ----- Embedding -----
# provider: openai | qwen
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIM=1536

# ----- Qdrant -----
# ":memory:" = embedded in-process store. Use the URL for docker.
QDRANT_URL=:memory:
QDRANT_COLLECTION=recordchat_one_record
QDRANT_UPSERT_BATCH_SIZE=128
# Optional. When set, docker-compose enables Qdrant API-key auth and the
# backend sends the same key. Leave empty for local unauthenticated Qdrant.
QDRANT_API_KEY=

# ----- Workflow connectors -----
RECORDFORGE_URL=
RECORDFORGE_API_KEY=

# ----- Diagnostics (AUD-07) -----
# stdout | off | path. Docker default is /app/data/logs/requests.jsonl
# (./data/logs is a writable overlay; the rest of data/ stays read-only).
# Local uv runs: data/logs/requests.jsonl is created under the repo.
RECORDCHAT_REQUEST_LOG=data/logs/requests.jsonl
# Default false: JSONL stores query_hash + query_len, not the raw question.
# true only for a short local debug session.
RECORDCHAT_REQUEST_LOG_INCLUDE_QUERY=false

# ----- RAG -----
RAG_TOP_K=5

# Canonical source versions (AUD-02 / #27). Comma-separated allowlists.
# Non-canonical copies stay on disk but are skipped at ingest / OntologyGraph.
CANONICAL_ONTOLOGY_VERSIONS=2025-07
CANONICAL_API_ONTOLOGY_VERSIONS=current
CANONICAL_OPENAPI_VERSIONS=2024-12
CANONICAL_SPEC_VERSIONS=development,2025-07

# ----- CORS / Frontend -----
# The browser must only talk to the frontend origin. The Next.js BFF uses
# INTERNAL_API_BASE_URL to reach FastAPI. Leave NEXT_PUBLIC_API_BASE_URL empty
# so the client never learns about :8000.
#
# Local:
#   CORS_ORIGINS=http://localhost:3000
#   INTERNAL_API_BASE_URL=http://127.0.0.1:8000   # or http://backend:8000 in Compose
#
# Public trial (AUTH-05): CORS_ORIGINS=https://<domain> and an empty
# NEXT_PUBLIC_API_BASE_URL. Do not publish backend :8000.
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=
INTERNAL_API_BASE_URL=

# ----- Trial auth (v0.3.1) -----
# off = local/CI, no Clerk required. enforced = public trial.
AUTH_MODE=off
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
